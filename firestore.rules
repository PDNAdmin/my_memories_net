rules_version = '2';
// Paste this into Firebase Console > Firestore Database > Rules.
// Replace the email(s) below with the family admin login(s).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['family-admin@example.com'];
    }

    match /memorials/{memorialId}/tributes/{tributeId} {
      // Anyone can read tributes
      allow read: if true;

      // Anyone can post, but only well-formed tributes
      allow create: if request.resource.data.keys().hasOnly(['name', 'relation', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.relation is string
        && request.resource.data.relation.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3 && request.resource.data.message.size() <= 3000
        && request.resource.data.createdAt == request.time;

      // Only the family can remove tributes; nobody can edit them
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
